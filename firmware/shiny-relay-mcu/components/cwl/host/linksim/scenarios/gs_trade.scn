# Gen 2 Cable Club trade (compat/run_gs_trade.sh in simulated time).
# A = Gold at the trade receptionist (tools/states/g_cc), B = Silver (s_cc).
# Pass: both parties swapped (peek wPartySpecies before / after).
thread A
sleep 2
keys a 1.5 a a a a a a a
thread B
sleep 5
keys b 1.5 a a a a a a a
thread M
peek a da22 3 party_before
peek a da30 2 mon1_id_before
peek b da22 3 party_before
peek b da30 2 mon1_id_before
sleep 19.5
keys ab 1.2 a a a a
sleep 6
keys ab 1.2 a a
sleep 6
waitq a 4 300
sleep 2
keys ab 1.0 a
sleep 8
shot room
keys ab 0.4 up up up up
keys a 0.4 right right right up up left
keys b 0.4 left left up up right
sleep 1
keys ab 0.5 a
mark seat
waitx a 1000 400
mark party_data
sleep 10
shot menu
keys ab 0.8 a
sleep 1.5
keys ab 0.8 right a
sleep 10
keys ab 0.8 a
mark trade_start
waitq a 20 600
mark trade_quiet
keys ab 1.5 a a a
sleep 30
shot end
peek a da22 3 party_after
peek a da30 2 mon1_id_after
peek b da22 3 party_after
peek b da30 2 mon1_id_after
