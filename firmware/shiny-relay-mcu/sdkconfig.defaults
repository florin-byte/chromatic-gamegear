# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.3.0 Project Minimal Configuration
#
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="1.0.2"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_CHROMATIC_FW_VER_STR="4.6"
CONFIG_CONSOLE_SORTED_HELP=y
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LV_COLOR_CHROMA_KEY_HEX=0xFF00FF
CONFIG_LV_USE_ASSERT_STYLE=y
CONFIG_LV_SPRINTF_USE_FLOAT=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# CWL1 Wi-Fi link: bigger app partition (Wi-Fi stack)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CWL1: 1 ms tick so the link task can wait 1 ms on its socket
CONFIG_FREERTOS_HZ=1000

# CWL: faster Wi-Fi rejoin after the link wakes Wi-Fi (no 0.5-1 s ARP probe of the offered address)
# CONFIG_LWIP_DHCP_DOES_ARP_CHECK is not set
CONFIG_LV_USE_QRCODE=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set
# wifimem1: the outgoing record buffer is allocated whole for every write (DYNAMIC_BUFFER): 2 KB
# instead of 4 KB takes ~2 KB off every TLS call's low point. Our largest write is the HTTP client's
# 1,536-byte header buffer; esp-tls splits anything longer. The incoming side stays 16 KB (the
# server's records may be full size).
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048

# 0.17.0 heap: 6 static Wi-Fi RX buffers (was 10, ~1.6 KB each, held for good); the link moves a few hundred bytes a second
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=4

# the card's FatFs (components/fatfs = the IDF's, exFAT on, 512-byte sectors): long names on the heap, UTF-8,
# one volume, files share the volume's window (no 512 B buffer per open file)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_PER_FILE_CACHE=n
CONFIG_FATFS_VOLUME_COUNT=1
CONFIG_FATFS_USE_LABEL=y

# fwshrink1: the TLS roots trimmed to the CAs our hosts' edges use (certs/make_roots.py says which and why):
# 17 roots instead of the IDF's 147-root Mozilla list
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_NONE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="certs/shiny_relay_roots.pem"

# fwshrink1: the app built for size (-Os; was the IDF default -Og). The boot loader has its own option (unchanged).
# cf_inflate.c / cf_sgz.c keep -O2 (components/nw/CMakeLists.txt).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# fwshrink1: only the LVGL widgets the screens create (label, img, line, table, tileview; canvas for the QR code):
# the default theme's branches and the classes of the others are no longer linked. Nothing else draws.
# CONFIG_LV_USE_ARC is not set
# CONFIG_LV_USE_BAR is not set
# CONFIG_LV_USE_BTN is not set
# CONFIG_LV_USE_BTNMATRIX is not set
# CONFIG_LV_USE_CHECKBOX is not set
# CONFIG_LV_USE_DROPDOWN is not set
# CONFIG_LV_USE_ROLLER is not set
# CONFIG_LV_USE_SLIDER is not set
# CONFIG_LV_USE_SWITCH is not set
# CONFIG_LV_USE_TEXTAREA is not set
# CONFIG_LV_USE_ANIMIMG is not set
# CONFIG_LV_USE_CALENDAR is not set
# CONFIG_LV_USE_CHART is not set
# CONFIG_LV_USE_COLORWHEEL is not set
# CONFIG_LV_USE_IMGBTN is not set
# CONFIG_LV_USE_KEYBOARD is not set
# CONFIG_LV_USE_LED is not set
# CONFIG_LV_USE_LIST is not set
# CONFIG_LV_USE_MENU is not set
# CONFIG_LV_USE_METER is not set
# CONFIG_LV_USE_MSGBOX is not set
# CONFIG_LV_USE_SPAN is not set
# CONFIG_LV_USE_SPINBOX is not set
# CONFIG_LV_USE_SPINNER is not set
# CONFIG_LV_USE_TABVIEW is not set
# CONFIG_LV_USE_WIN is not set
# CONFIG_LV_USE_SNAPSHOT is not set
# CONFIG_LV_BUILD_EXAMPLES is not set

# fwshrink1: mbedTLS as the firmware uses it. TLS client only (nothing here serves TLS: the setup portal is plain
# http). Elliptic curves: P-256, P-384, P-521 and X25519 (the key exchange and every ECC root kept; WPA3 SAE groups
# 19-21); the others were never offered by our servers nor used by a kept root.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED is not set

# fwshrink1: no IPv6 in lwIP. The firmware never made an IPv6 address (no link-local, no autoconfig: every
# connection, DNS answer and the setup portal were IPv4 already); TCP/UDP control blocks shrink with it.
# CONFIG_LWIP_IPV6 is not set
