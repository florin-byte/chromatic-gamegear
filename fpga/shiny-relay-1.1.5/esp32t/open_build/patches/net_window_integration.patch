         .h_ev_valid          (link_h_ev_valid),
         .h_ev_type           (link_h_ev_type),
         .h_ev_byte           (link_h_ev_byte)
+    );
+
+    // Network window (NETWORK_WINDOW.md): GB CPU mailbox at FF58-FF5F <-> ESP32.
