diff -ruN a/esp32t/sim_cwl/run_tb_warm.sh b/esp32t/sim_cwl/run_tb_warm.sh
--- a/esp32t/sim_cwl/run_tb_warm.sh
+++ b/esp32t/sim_cwl/run_tb_warm.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+# run_tb_warm.sh [old-video.v]: build tb_warm.v around the color temperature stage of this tree's video.v and of the
+# 18.32 video.v (git show HEAD:... of the commit before the warm whites change), run it with iverilog
+set -e
+cd "$(dirname "$0")"
+V=../src/rtl/EMU/CORE/video.v
+OLDREF=${1:-8cb9966}
+T=${TMPDIR:-/tmp}/tb_warm_$$; mkdir -p $T
+ext() { # file -> the stage (functions + wires up to lcd_rgb_temp)
+  sed -n '/^function \[4:0\] sat_add5/,/^wire \[14:0\] lcd_rgb_temp/p' "$1"
+}
+mk() { # name file
+  { echo "module $1(input [14:0] lcd_rgb_raw, input [2:0] gbc_color_temp, input isGBC_mode, output [14:0] out_px);"; ext "$2"; echo "assign out_px = lcd_rgb_temp;"; echo endmodule; } > $T/$1.v
+}
+mk warm_new $V
+git show "$OLDREF:esp32t/src/rtl/EMU/CORE/video.v" > $T/old_video.v
+mk warm_old $T/old_video.v
+iverilog -g2012 -o $T/tb_warm.vvp tb_warm.v $T/warm_new.v $T/warm_old.v
+vvp $T/tb_warm.vvp
diff -ruN a/esp32t/sim_cwl/tb_warm.v b/esp32t/sim_cwl/tb_warm.v
--- a/esp32t/sim_cwl/tb_warm.v
+++ b/esp32t/sim_cwl/tb_warm.v
@@ -0,0 +1,55 @@
+// tb_warm.v (18.33, warm whites): the color temperature stage of video.v, extracted from the real file by run_tb_warm.sh
+//   warm_new = this tree's video.v (the shift on every game), warm_old = the 18.32 video.v (the shift on GBC games only)
+// Checks over ALL 32768 pixels x levels 0..7 (6 and 7 clamp to 5) x isGBC_mode 0/1:
+//   GBC game: new == old (a Game Boy Color game is unchanged);  level 0: new == raw pixel (NEUTRAL = 18.32 on a DMG game);
+//   DMG game, level > 0: old == raw (18.32 never warmed it), new warms exactly the pixels with 2+ bright channels
+//   (a dark pixel, bit 4 clear in two or more channels, is untouched), red never falls, blue never rises, and
+//   the shift is monotonic in the level.
+`timescale 1ns/1ps
+module tb_warm;
+    reg  [14:0] raw;
+    reg  [2:0]  lvl;
+    reg         gbcm;
+    wire [14:0] n, o;
+    warm_new u_n(.lcd_rgb_raw(raw), .gbc_color_temp(lvl), .isGBC_mode(gbcm), .out_px(n));
+    warm_old u_o(.lcd_rgb_raw(raw), .gbc_color_temp(lvl), .isGBC_mode(gbcm), .out_px(o));
+    integer p, l, g, bad, cnt, warmed, dark_bad, mono_bad;
+    reg [14:0] prev;
+    function [2:0] lv; input [2:0] x; lv = x > 5 ? 5 : x; endfunction
+    initial begin
+        bad = 0; cnt = 0; warmed = 0; dark_bad = 0; mono_bad = 0;
+        for (g = 0; g < 2; g = g + 1)
+          for (p = 0; p < 32768; p = p + 1) begin
+            prev = p;
+            for (l = 0; l < 8; l = l + 1) begin
+                raw = p; lvl = l; gbcm = g; #1;
+                cnt = cnt + 1;
+                if (g == 1 && n !== o) begin bad = bad + 1; if (bad < 10) $display("GBC MISMATCH px %h lvl %0d new %h old %h", raw, l, n, o); end
+                if (g == 0 && o !== raw) begin bad = bad + 1; if (bad < 10) $display("OLD DMG NOT RAW px %h lvl %0d", raw, l); end
+                if (l == 0 && n !== raw) begin bad = bad + 1; if (bad < 10) $display("NEUTRAL CHANGED px %h new %h", raw, n); end
+                if (g == 0 && l > 0) begin
+                    if (((raw[4] + raw[9] + raw[14]) < 2) && n !== raw) begin dark_bad = dark_bad + 1; if (dark_bad < 10) $display("DARK MOVED px %h lvl %0d new %h", raw, l, n); end
+                    if (n[4:0] < raw[4:0] || n[14:10] > raw[14:10]) begin bad = bad + 1; if (bad < 10) $display("WRONG DIRECTION px %h new %h", raw, n); end
+                    if (n !== raw) warmed = warmed + 1;
+                end
+                if (g == 0 && l >= 1 && l <= 5) begin
+                    // monotonic: red up, blue down as the level rises
+                    if (l > 1 && (n[4:0] < prev[4:0] || n[14:10] > prev[14:10])) mono_bad = mono_bad + 1;
+                    prev = n;
+                end
+            end
+          end
+        // the lightest shades of three typical palettes at every level (for the log)
+        gbcm = 0;
+        for (l = 0; l < 6; l = l + 1) begin
+            lvl = l;
+            raw = 15'h7FFF; #1; $write("white 7FFF lvl %0d -> %h ", l, n);
+            raw = {5'd1, 5'd23, 5'd19}; #1; $write("| green-lightest -> %h ", n);   // 9BBC0F-like (b,g,r)
+            raw = {5'd6, 5'd13, 5'd19}; #1; $write("| light-mid -> %h ", n);
+            raw = {5'd2, 5'd2, 5'd2}; #1; $display("| dark -> %h", n);
+        end
+        $display("checked %0d cases: bad %0d dark_moved %0d mono_bad %0d, DMG pixels warmed %0d", cnt, bad, dark_bad, mono_bad, warmed);
+        if (bad == 0 && dark_bad == 0 && mono_bad == 0 && warmed > 0) $display("TB_WARM PASS"); else $display("TB_WARM FAIL");
+        $finish;
+    end
+endmodule
